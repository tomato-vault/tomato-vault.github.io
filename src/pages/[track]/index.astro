---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, TRACK_META } from '../../consts';
import { TRACKS } from '../../content.config';
import { getPosts, slugOf } from '../../lib/posts';

export async function getStaticPaths() {
	return TRACKS.map((track) => ({ params: { track } }));
}

const { track } = Astro.params as { track: keyof typeof TRACK_META };
const meta = TRACK_META[track];
const posts = await getPosts({ track });
---

<html lang="ko">
	<head>
		<BaseHead title={`${meta.label} — ${SITE_TITLE}`} description={meta.blurb} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} · ${meta.label}`} href={`/${track}/rss.xml`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{meta.label}</h1>
			<p>{meta.blurb}</p>
			{posts.length === 0 && <p><em>아직 발행한 글이 없습니다.</em></p>}
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/${track}/${slugOf(post)}/`}>{post.data.title}</a>
						<p>{post.data.description}</p>
						<FormattedDate date={post.data.pubDate} />
						{post.data.draft && <span> · <strong>DRAFT</strong></span>}
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
